# Copy to dev/.env (gitignored) or export these variables in the shell.
# dev/bootstrap-ha.py rewrites dev/.env with the real HA token automatically,
# so normally this file is documentation only.
#
# Long-lived Home Assistant token for the addon (dev mode, no Supervisor).
PULSAR_BRAIN_HA_TOKEN=
# Used by dev/bootstrap-ha.py and dev/check.sh.
DEV_HA_URL=http://127.0.0.1:8124
DEV_HA_USER=dev
DEV_HA_PASS=devpass

# Addon dev env (set inside dev/docker-compose.yml, documented here for clarity).
# PULSAR_BRAIN_MOCK=1 selects the deterministic mock LLM provider.
